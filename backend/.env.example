# ====================================================================
# OBRAMASTER - SERVIDOR BACKEND MULTIMODAL GEMINI IA
# ====================================================================

# Puerto del servidor backend local (por defecto 3000)
PORT=3000

# Clave de API de Google Gemini (Google AI Studio)
# Consíguela gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_tu_clave_de_gemini_aqui

# Modelo Gemini (gemini-1.5-flash recomendado por rapidez y soporte multimodal nativo)
GEMINI_MODEL=gemini-1.5-flash

# Origen permitido para CORS (puerto por defecto de Vite)
CORS_ORIGIN=http://localhost:5173
