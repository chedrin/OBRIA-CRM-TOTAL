{
  "name": "ObraMaster - Portal del Obrero",
  "short_name": "Portal Obrero",
  "description": "Portal móvil independiente para operarios en obra. Control horario, tareas asignadas, partes de avance con fotos y notas de voz.",
  "start_url": "./#empleados",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#020617",
  "theme_color": "#f59e0b",
