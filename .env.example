# ====================================================================
# OBRAMASTER - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ====================================================================

# --------------------------------------------------------------------
# 0. CONFIGURACIÓN DE BASE DE DATOS SUPABASE
# --------------------------------------------------------------------
# URL y Clave Anónima de tu proyecto Supabase:
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...tu_clave_anon_aqui
# Mismas URL y clave anónima para el servidor (login y gestión de usuarios):
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave de Servicio (service_role): SOLO en el servidor (Render). Da acceso total a la base de datos.
# NUNCA le pongas el prefijo VITE_ ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...tu_clave_service_role_aqui

# --------------------------------------------------------------------
# 1. MOTOR DE INTELIGENCIA ARTIFICIAL (GEMINI / OPENAI / ANTHROPIC)
# --------------------------------------------------------------------
# SOLO SERVIDOR. NUNCA les pongas el prefijo VITE_: todo lo que empieza por
# VITE_ se incluye en la web y lo puede leer cualquiera desde el navegador.
#
# Google Gemini (gratis en https://aistudio.google.com/app/apikey):
GEMINI_API_KEY=AIzaSyD_tu_clave_gemini_aqui
# OpenAI (https://platform.openai.com/api-keys), también para Whisper:
OPENAI_API_KEY=sk-proj-tu_clave_openai_aqui
# Anthropic Claude (https://console.anthropic.com/settings/keys):
ANTHROPIC_API_KEY=sk-ant-tu_clave_anthropic_aqui
# Proveedor activo por defecto: google | openai | anthropic
AI_PROVIDER=google

# --------------------------------------------------------------------
# 2. ENVÍO DE DOCUMENTOS POR EMAIL (RESEND API)
# --------------------------------------------------------------------
# Pasos completos (dominio, DNS, clave): docs/correo-resend.md
# Presupuestos, facturas, pedidos y subcontratas los envía el SERVIDOR: sin prefijo VITE_.
# Con onboarding@resend.dev solo llega a tu propio correo de Resend: usa tu dominio verificado.
# (Si aún tienes VITE_RESEND_API_KEY en tu .env o en Render, bórrala y rota esa clave.)
RESEND_API_KEY=re_tu_clave_resend_aqui
RESEND_FROM_EMAIL=Tu Empresa <presupuestos@tudominio.es>
# Dirección pública de la app, para los enlaces de subcontratas (/sub/<token>):
PUBLIC_APP_URL=https://obria-crm.onrender.com
# Notificaciones push (Web Push). Generar una vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# --------------------------------------------------------------------
# 3. ENVÍO DE DOCUMENTOS POR WHATSAPP (META CLOUD API)
# --------------------------------------------------------------------
# Configuración en Meta for Developers (WhatsApp Cloud API):
# https://developers.facebook.com/apps/
# Si dejas estas variables vacías, el sistema utilizará automáticamente
# el envío directo e instantáneo a través de WhatsApp Web / App (wa.me) sin coste.
# SOLO SERVIDOR (sin VITE_). Si tenías VITE_WHATSAPP_ACCESS_TOKEN, bórrala y rota el token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --------------------------------------------------------------------
# 4. SEGURIDAD
# --------------------------------------------------------------------
# Otros dominios que pueden llamar a la API desde el navegador, separados por comas.
# Vacío = solo el propio dominio de la app (lo normal; en local Vite usa su proxy).
CORS_ORIGIN=

# --------------------------------------------------------------------
# 5. FACTURACIÓN VERI*FACTU (solo servidor; ver docs/verifactu.md)
# --------------------------------------------------------------------
# Clave para cifrar los certificados digitales guardados en la base de datos.
# Generar una vez con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CERT_ENCRYPTION_KEY=
# Datos del productor del sistema informático (salen en la declaración responsable y en cada registro).
VERIFACTU_PRODUCTOR_NOMBRE=
VERIFACTU_PRODUCTOR_NIF=
VERIFACTU_PRODUCTOR_DIRECCION=
VERIFACTU_PRODUCTOR_EMAIL=
# Fecha (AAAA-MM-DD) y lugar (localidad y país) en que se firma la declaración; obligatorios para pasar a producción.
VERIFACTU_DECLARACION_FECHA=
VERIFACTU_DECLARACION_LUGAR=
# Opcional: número de instalación (por defecto 1) y desactivar la cola automática de envíos.
VERIFACTU_NUMERO_INSTALACION=
VERIFACTU_COLA_DESACTIVADA=
