# ====================================================================
# OBRAMASTER - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ====================================================================

# --------------------------------------------------------------------
# 1. MOTOR DE INTELIGENCIA ARTIFICIAL (GEMINI / OPENAI / ANTHROPIC)
# --------------------------------------------------------------------
# Obtén tu clave gratuita de Google Gemini en Google AI Studio:
# https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSyD_tu_clave_gemini_aqui

# (Opcional) OpenAI para Whisper Cloud y GPT-4o:
# https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-proj-tu_clave_openai_aqui

# (Opcional) Anthropic Claude:
# https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=sk-ant-tu_clave_anthropic_aqui

# --------------------------------------------------------------------
# 2. ENVÍO DE DOCUMENTOS POR EMAIL (RESEND API)
# --------------------------------------------------------------------
# Regístrate gratis en https://resend.com y genera tu API Key (re_...)
VITE_RESEND_API_KEY=re_tu_clave_resend_aqui
# Remitente verificado en Resend o correo por defecto:
VITE_RESEND_FROM_EMAIL=ObraMaster <presupuestos@obramaster.app>

# --------------------------------------------------------------------
# 3. ENVÍO DE DOCUMENTOS POR WHATSAPP (META CLOUD API)
# --------------------------------------------------------------------
# Configuración en Meta for Developers (WhatsApp Cloud API):
# https://developers.facebook.com/apps/
# Si dejas estas variables vacías, el sistema utilizará automáticamente
# el envío directo e instantáneo a través de WhatsApp Web / App (wa.me) sin coste.
VITE_WHATSAPP_PHONE_NUMBER_ID=109283746501928
VITE_WHATSAPP_ACCESS_TOKEN=EAAG...tu_token_permanente_meta
